{
  "manifest_version": 3,
  "name": "XScroller - AI Twitter Engagement",
  "version": "1.0.0",
  "description": "Auto-scroll Twitter/X and engage with AI-powered replies",

  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],

  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon128.png",
      "48": "assets/icon128.png",
      "128": "assets/icon128.png"
    }
  },

  "icons": {
    "16": "assets/icon128.png",
    "48": "assets/icon128.png",
    "128": "assets/icon128.png"
  },

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "lib/storage.js",
        "lib/persona.js",
        "content/detector.js",
        "content/scroller.js",
        "content/replier.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "options_page": "options/options.html"
}
